@startuml
!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Container.puml

title C4 — Уровень контейнеров для экосистемы "Тёплый дом"

Person(user, "Пользователь", "Управляет устройствами умного дома через веб или мобильное приложение.")
System_Boundary(Экосистема, "Экосистема 'Тёплый дом'") {
    Container(API_Gateway, "API Gateway", "Spring Boot", "Маршрутизирует запросы пользователей к микросервисам.")
    Container(УправлениеУстройствами, "Управление устройствами", "Java + Spring Boot", "Регистрация и управление устройствами.")
    Container(УправлениеОтоплением, "Управление отоплением", "Java + Spring Boot", "Контролирует реле отопления.")
    Container(Мониторинг, "Мониторинг", "Java + Spring Boot", "Анализирует и сохраняет телеметрию.")
    Container(Уведомления, "Сервис уведомлений", "Node.js", "Отправляет уведомления пользователям.")
    Container(Пользователи, "Пользователи и авторизация", "Java + Spring Boot", "Управляет учетными записями.")
    Container(Интеграция, "Интеграция с партнёрами", "Python", "Подключает устройства сторонних производителей.")
    Container(Сценарии, "Сервис автоматизации", "Node.js", "Настраивает автоматические сценарии.")

    ContainerDb(DB_Devices, "БД устройств", "PostgreSQL", "Сохраняет данные об устройствах.")
    ContainerDb(DB_Template, "БД сервиса автоматизации", "PostgreSQL", "Сохраняет настройки сценариев автоматизации.")
    ContainerDb(DB_Temp, "БД температур", "PostgreSQL", "Сохраняет телеметрию.")
    ContainerDb(DB_Users, "БД пользователей", "PostgreSQL", "Сохраняет данные о пользователях.")
    ContainerDb(DB_Event, "БД уведомлений", "PostgreSQL", "Хранит шаблоны уведомлений.")

    Container(Kafka, "Kafka", "Шина данных", "Асинхронный обмен данными между микросервисами.")
}

System_Ext(Email, "E-Mail Сервер", "Передают уведомления на почту.")
System_Ext(Telegram, "Telegram", "Передают уведомления через Телеграмм бота.")
System_Ext(Gateway, "Шлюз умного дома", "Общается с датчиками других производителй по протоколам Zigbee, Wi-Fi, Thread.")

Rel(user, API_Gateway, "Взаимодействует через REST API")
Rel(Gateway, API_Gateway, "Взаимодействует через REST API")
Rel(API_Gateway, УправлениеУстройствами, "Маршрутизирует запросы")
Rel(API_Gateway, УправлениеОтоплением, "Маршрутизирует запросы")
Rel(API_Gateway, Мониторинг, "Маршрутизирует запросы")
Rel(API_Gateway, Пользователи, "Маршрутизирует запросы")
Rel(API_Gateway, Уведомления, "Маршрутизирует запросы")
Rel(API_Gateway, Сценарии, "Маршрутизирует запросы")
Rel(УправлениеУстройствами, Kafka, "Публикует события о подключении устройств")
Rel(Мониторинг, Kafka, "Публикует телеметрию")
Rel(Сценарии, Kafka, "Потребляет события для автоматизации")
Rel(Сценарии, DB_Template, "Чтение/Запись сценариев автоматизации")
Rel(УправлениеОтоплением, Kafka, "Потребляет команды от сценариев")
Rel(Интеграция, Kafka, "Публикует события о статусе устройств партнёров")
Rel(Мониторинг, DB_Temp, "Сохраняет данные о температуре")
Rel(УправлениеУстройствами, DB_Devices, "Сохраняет данные об устройствах")
Rel(Пользователи, DB_Users, "Сохраняет данные о пользователях")
Rel(Уведомления, Kafka, "Потребляет события для отправки уведомлений")
Rel(Уведомления, DB_Event, "Потребляет шаблоны уведомлений")
Rel(Уведомления, Email, "Отправляет уведомления пользователям на почту.")
Rel(Уведомления, Telegram, "Отправляет уведомления пользователям в Телеграм")

@enduml